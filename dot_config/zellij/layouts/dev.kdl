layout {
  default_tab_template {
    children
    pane {
      zjstatus
    }
  }

  // Initial tab: vertical split — 2 panes left, 4 stacked panes right
  pane split_direction="vertical" {
    pane split_direction="horizontal" {
      pane
      pane
    }
    pane stacked=true {
      pane
      pane
      pane
      pane
    }
  }
}
