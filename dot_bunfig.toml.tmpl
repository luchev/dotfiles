{{- if env "NPM_REGISTRY_URL" -}}
# bun does not read the _auth line in ~/.npmrc, so `bun install` fails against
# an authenticated private registry while npm succeeds from the same file.
#
# Registry and credentials are host-specific and stay out of this repo. This
# file renders only when NPM_REGISTRY_URL is set at apply time:
#   NPM_REGISTRY_URL=https://registry.example.com/ chezmoi apply
# Credentials are interpolated from the environment at bun runtime; set
# NPM_REGISTRY_USER / NPM_REGISTRY_PASS in ~/.config-local.nu (untracked).
#
# If bun starts 401ing, check those vars are exported: an unset $VAR
# interpolates to empty and looks identical to a missing credential.

[install.registry]
url = "{{ env "NPM_REGISTRY_URL" }}"
username = "$NPM_REGISTRY_USER"
password = "$NPM_REGISTRY_PASS"
{{- end -}}
