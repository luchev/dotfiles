argc-completions
argc-custom-completions

# Repo's own docs — not dotfiles. Without these they get applied to ~/README.md
# and ~/CLAUDE.md, where CLAUDE.md's relative @import cannot resolve.
# Anchored: unanchored patterns match at any depth and would swallow a skill's
# own README.md.
/README.md
/CLAUDE.md

# Machine-specific (holds a signingkey); managed by hand, not chezmoi.
/.gitconfig

# claude-mem local store: SQLite DB + Chroma index of all project memory, plus
# API keys in .env. This repo is public and the memory contains work detail, so
# it is never committed. Rebuildable from the canonical markdown in
# ~/.claude/projects/*/memory/ via bin/mem-migrate.py.
.claude-mem

# Generated by `graphify install` (see run_once_install-python-pkgs.sh), not
# hand-written. 108K of vendored skill content that upstream regenerates.
.config/opencode/skills/graphify

# Repo docs — reference material, never applied to $HOME.
/docs

# Local secrets (registry credentials, Bitwarden-synced env). Sourced by
# config.nu, deliberately outside this repo — it is public.
/.config-local.nu

# Host-specific LLM gateway for claude-mem (helper path + base URL). Read at
# runtime by bin/claude-mem-refresh-token.sh; kept out of this public repo.
/.config/claude-mem-gateway.conf

# ~/.bunfig.toml is only managed when a registry is supplied at apply time:
#   NPM_REGISTRY_URL=https://registry.example.com/ chezmoi apply
# Otherwise leave any existing file alone — rendering the template without the
# variable would silently blank a working config.
{{ if not (env "NPM_REGISTRY_URL") }}/.bunfig.toml{{ end }}
