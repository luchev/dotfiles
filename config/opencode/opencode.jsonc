{
  "$schema": "https://opencode.ai/config.json",

  // System theme — inherits terminal transparency (Ghostty opacity, etc.)
  "theme": "system",

  // ── Plugins ───────────────────────────────────────────────────────────────────
  // OpenCode auto-installs these on first run.
  // opencode-pty:                interactive PTY management — dev servers, REPLs,
  //                              long-running processes as background sessions.
  //                              Tools: pty_spawn, pty_write, pty_read, pty_list, pty_kill
  //                              Slash: /pty-open-background-spy, /pty-show-server-url
  // @tarquinen/opencode-dcp:     Dynamic Context Pruning — removes stale/duplicate tool
  //                              outputs from context in real-time without touching session
  //                              history. Cuts token usage 50-80% in long sessions.
  //                              Strategies: deduplication, error-purging, compression.
  // oh-my-openagent:             Batteries-included harness — multi-model orchestration,
  //                              parallel background agents, LSP/AST tools.
  //                              (auto-migrated from oh-my-opencode)
  // opencode-notify:             Desktop notifications for permission requests,
  //                              session completion, and errors.
  // @ramtinj95/opencode-tokenscope: Token usage analysis with per-category
  //                              breakdowns, visual charts, and subagent cost tracking.
  // opencode-mem:                Local persistent memory — Turso/libSQL vector DB,
  //                              auto-capture, web UI at http://127.0.0.1:4747.
  // opencode-browser:                 Browser automation via Browser MCP — control
  //                              Chrome/Edge (click, type, screenshot, scrape).
  //                              Requires the Browser MCP extension in Chrome.
  //                              Speed-optimized prompt guidance for browser tools.
  // @azumag/opencode-rate-limit-fallback: When the current model 429s / runs out
  //                              of credits, abort and retry on the next credited
  //                              model. Chain in rate-limit-fallback.json.
  // opencode-copy-message:      Copy messages from the opencode TUI — last
  //                              message, any message, transcript popup, or
  //                              external editor.
  // opencode-session-surf:      Session surfing — browse/search past sessions
  //                              from the TUI (github.com/luchev/opencode-session-surf).
  "plugin": [
    "@azumag/opencode-rate-limit-fallback",
    "opencode-pty",
    "@tarquinen/opencode-dcp",
    "oh-my-openagent@latest",
    "opencode-obsidian",
    "opencode-notify",
    "@ramtinj95/opencode-tokenscope",
    "opencode-copy-message",
    "opencode-session-surf",
    "opencode-mem",
    "opencode-browser"
  ],

  // ── Provider ─────────────────────────────────────────────────────────────────
  // DeepSeek via its Anthropic-compatible API — mirrors the Claude Code setup
  // in nushell/config.nu:
  //   ANTHROPIC_BASE_URL         = https://api.deepseek.com/anthropic
  //   ANTHROPIC_AUTH_TOKEN       = $DEEPSEEK_API_KEY
  //   ANTHROPIC_DEFAULT_SONNET/OPUS_MODEL = deepseek-v4-pro[1m]
  //   ANTHROPIC_DEFAULT_HAIKU_MODEL       = deepseek-v4-flash
  //   CLAUDE_CODE_SUBAGENT_MODEL          = deepseek-v4-flash
  //   CLAUDE_CODE_EFFORT_LEVEL   = max
  "provider": {
    "deepseek": {
      "npm": "@ai-sdk/anthropic",
      "name": "DeepSeek",
      "options": {
        "baseURL": "https://api.deepseek.com/anthropic",
        "apiKey": "{env:DEEPSEEK_API_KEY}"
      },
      "models": {
        // Pro — mirrors ANTHROPIC_DEFAULT_SONNET/OPUS_MODEL (deepseek-v4-pro[1m])
        "deepseek-v4-pro": {
          "name": "DeepSeek V4 Pro",
          "reasoning": true
        },
        // Flash — mirrors ANTHROPIC_MODEL / ANTHROPIC_DEFAULT_HAIKU_MODEL
        "deepseek-v4-flash": {
          "name": "DeepSeek V4 Flash"
        },
        // Flash Free — default model (current session)
        "deepseek-v4-flash-free": {
          "name": "DeepSeek V4 Flash Free"
        },

      }
    }
  },

  // Only use subscribed providers; ignore all other auto-detected providers.
  "enabled_providers": ["opencode-go", "opencode", "deepseek"],

  // ── Models ───────────────────────────────────────────────────────────────────
  // Primary model for main agents
  "model": "opencode/deepseek-v4-flash-free",
  // Lightweight tasks (title generation, etc.)
  "small_model": "opencode/deepseek-v4-flash-free",

  // ── Agents ───────────────────────────────────────────────────────────────────
  "agent": {
    "build": {
      "steps": 100,
      "model": "opencode/deepseek-v4-flash-free"
    },
    "Sisyphus-Junior": { "model": "opencode/deepseek-v4-flash-free" },
    "explore": { "model": "opencode/deepseek-v4-flash-free" },
    "librarian": { "model": "opencode/deepseek-v4-flash-free" },
    "multimodal-looker": { "model": "opencode/deepseek-v4-flash-free" },
    "oracle": { "model": "opencode/deepseek-v4-flash-free" },
    "title": { "model": "opencode/deepseek-v4-flash-free" },
    "summary": { "model": "opencode/deepseek-v4-flash-free" }
  },
  // ── Permissions ───────────────────────────────────────────────────────────────
  // Allow all tools without prompts — matches the broad allow-list in
  // claude/settings.local.json
  "permission": "allow",

  // ── Context / compaction ─────────────────────────────────────────────────────
  "compaction": {
    "auto": true,   // compact automatically when context fills
    "prune": true   // remove stale tool outputs to save tokens
  },

  // ── Instructions ─────────────────────────────────────────────────────────────
  // Migrated from Claude Code (CLAUDE.md + engineering-principles.md)
  "instructions": ["~/.config/opencode/instructions.md"],

  // ── Skills ───────────────────────────────────────────────────────────────────
  // Migrated from ~/.claude/skills and ~/.gemini/skills into a unified set.
  // On work machines this path is instead listed in the work-owned
  // opencode.json, alongside its skill prefixes.
  "skills": {
    "paths": ["~/.config/opencode/skills"]
  },
  // ── Experimental ─────────────────────────────────────────────────────────────
  "experimental": {
    // Parallel tool calls in a single round-trip — significant speedup
    "batch_tool": true
  },

  // ── MCP servers ──────────────────────────────────────────────────────────────
  // All MCP servers proxied through lazy-mcp — 4 meta-tools (~1.5k tokens) instead
  // of 78 full schemas (~12-16k tokens). Downstream schemas load on demand.
  // Server config: ~/.config/lazy-mcp/servers.json (repo: config/lazy-mcp/)
  "mcp": {
    "lazy-mcp": {
      "type": "local",
      "command": ["npx", "lazy-mcp@latest"],
      "enabled": true
    }
  },

  // ── Misc ─────────────────────────────────────────────────────────────────────
  "autoupdate": "notify",   // show update notifications, don't auto-install
  "share": "disabled",      // disable session sharing
  "snapshot": true,         // track file snapshots for undo/revert
  "lsp": true,              // enable built-in LSP servers for code diagnostics
  "formatter": true         // auto-format files after edits (rustfmt, prettier…)
}
