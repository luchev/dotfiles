#!/usr/bin/env bash
# ralph — drive a long task by looping opencode on a prompt file until the
# agent prints a completion marker. Git commits are the loop's memory.
#
#   ralph                    # grind ./PROMPT.md
#   ralph -f plan.md -n 50   # custom file, more iterations
#   ralph -m provider/model  # pin a model
set -uo pipefail

usage() {
  cat <<EOF
usage: ralph [-f FILE] [-m MODEL] [-n MAX] [--marker STR] [--no-commit] [-h]

  -f FILE         prompt file (default: ./PROMPT.md)
  -m MODEL        pass through to \`opencode run -m\`
  -n MAX          max iterations (default: 25)
  --marker STR    completion marker (default: RALPH_COMPLETE)
  --no-commit     don't git-commit progress each iteration
  -h              this help
EOF
}

PROMPT_FILE="PROMPT.md"
MODEL=""
MAX_ITERS=25
MARKER="RALPH_COMPLETE"
COMMIT=1

while [[ $# -gt 0 ]]; do
  case "$1" in
    -f) PROMPT_FILE="$2"; shift 2 ;;
    -m) MODEL="$2"; shift 2 ;;
    -n) MAX_ITERS="$2"; shift 2 ;;
    --marker) MARKER="$2"; shift 2 ;;
    --no-commit) COMMIT=0; shift ;;
    -h|--help) usage; exit 0 ;;
    *) echo "ralph: unknown arg: $1" >&2; usage >&2; exit 2 ;;
  esac
done

if [[ ! -f "$PROMPT_FILE" ]]; then
  echo "ralph: prompt file not found: $PROMPT_FILE" >&2
  echo "write one first (see the 'ralph' opencode skill)" >&2
  exit 2
fi

if [[ "$COMMIT" -eq 1 ]]; then
  if ! git rev-parse --is-inside-work-tree >/dev/null 2>&1; then
    echo "ralph: not a git repo (checkpointing needs it); use --no-commit to skip" >&2
    exit 2
  fi
fi

LOG_DIR=".ralph"
mkdir -p "$LOG_DIR"

# keep ralph/opencode runtime dirs out of git status without touching tracked .gitignore
if [[ "$COMMIT" -eq 1 ]]; then
  for d in ".ralph/" ".omo/"; do
    git check-ignore -q "$d" 2>/dev/null && continue
    grep -qxF "$d" .git/info/exclude 2>/dev/null || echo "$d" >> .git/info/exclude
  done
fi

# true when a checkpoint-worthy diff exists (also true before the first commit)
has_diff() {
  git rev-parse -q --verify HEAD >/dev/null 2>&1 || return 0
  ! git diff-index --quiet HEAD --
}

PROMPT_BODY="$(cat "$PROMPT_FILE")"
COMMIT_RULE="4. Commit the chunk: git add -A && git commit with a clear message."
[[ "$COMMIT" -eq 0 ]] && COMMIT_RULE="4. Do NOT commit."

read -r -d '' PROTOCOL <<EOF || true

---

AUTONOMOUS CONTINUATION PROTOCOL (ralph):
You are ONE iteration of an autonomous loop. A fresh instance runs every
iteration; git history is your only memory of previous iterations.
1. Inspect state first: git log --oneline -20, git status, existing files.
2. Pick the NEXT SMALLEST meaningful chunk of work toward the goal.
3. Do the chunk, then VERIFY it (build/tests/lint — proof, not vibes).
$COMMIT_RULE
5. ABSOLUTE FINAL LINE of your reply must be EXACTLY one of:
$MARKER  (only if EVERY goal criterion above is met AND verified)
RALPH_BLOCKED: <reason>  (only if truly stuck and a human must decide)
Any other ending means the loop continues with the next chunk.
Never claim $MARKER while checklist items remain.
EOF

echo "ralph: file=$PROMPT_FILE max=$MAX_ITERS marker=$MARKER commit=$COMMIT"
START_HEAD=""
if [[ "$COMMIT" -eq 1 ]]; then
  if has_diff; then
    echo "ralph: WARNING dirty tree — pre-existing changes land in the first checkpoint commit"
  fi
  START_HEAD="$(git rev-parse HEAD 2>/dev/null || true)"
fi

fail_streak=0
for ((i = 1; i <= MAX_ITERS; i++)); do
  log="$LOG_DIR/log-$i.txt"
  echo ""
  echo "── ralph iteration $i/$MAX_ITERS ──────────────────────────"

  # stderr (plugin/logger noise) → console only; log keeps agent stdout so the
  # final-line marker check is clean
  if [[ -n "$MODEL" ]]; then
    opencode run -m "$MODEL" "$PROMPT_BODY$PROTOCOL" 2> >(cat >&2) | tee "$log"
  else
    opencode run "$PROMPT_BODY$PROTOCOL" 2> >(cat >&2) | tee "$log"
  fi
  rc=${PIPESTATUS[0]}

  last_line="$(grep -v '^[[:space:]]*$' "$log" | tail -1)"

  if [[ "${last_line//[$'\r\t' ]/}" == "$MARKER" ]]; then
    echo ""
    echo "ralph: COMPLETE after $i iteration(s). Logs: $log"
    if [[ "$COMMIT" -eq 1 ]]; then
      if [[ -n "$START_HEAD" ]]; then
        echo "ralph: review with: git log -p $START_HEAD..HEAD — do NOT push unreviewed."
      else
        echo "ralph: review with: git log -p — do NOT push unreviewed."
      fi
    fi
    echo "ralph: run /learn in an opencode session to bank lessons."
    exit 0
  fi

  if [[ "$last_line" == RALPH_BLOCKED:* ]]; then
    reason="${last_line#RALPH_BLOCKED: }"; reason="${reason#RALPH_BLOCKED:}"
    echo ""
    echo "ralph: BLOCKED by agent after $i iteration(s):$reason" >&2
    echo "ralph: full log: $log" >&2
    exit 3
  fi

  if [[ "$rc" -ne 0 ]]; then
    fail_streak=$((fail_streak + 1))
    echo "ralph: opencode exited $rc ($fail_streak in a row)"
    if [[ "$fail_streak" -ge 3 ]]; then
      echo "ralph: 3 consecutive failures — aborting. Last log: $log" >&2
      exit 4
    fi
  else
    fail_streak=0
  fi

  if [[ "$COMMIT" -eq 1 ]] && has_diff; then
    git add -A && git commit -q -m "ralph: iteration $i checkpoint" \
      && echo "ralph: checkpoint committed (iteration $i)"
  elif [[ "$COMMIT" -eq 1 ]]; then
    echo "ralph: no changes this iteration"
  fi
done

echo ""
echo "ralph: gave up after $MAX_ITERS iterations without $MARKER." >&2
echo "ralph: inspect logs in $LOG_DIR/, refine the prompt's DONE criteria, rerun." >&2
exit 5
